---
// Community section: field notes from community discussions
// Data-driven: posts sourced from src/data/community-posts.json at build time
import communityData from '../../data/community-posts.json';
---

<section class="community-section">
  <p class="section-moral">
    <em>The shepherd posted his flock's numbers; the wolves already knew theirs.</em>
  </p>

  <h2 id="community">Community — field notes in public</h2>

  <p class="community-intro">
    <span class="community-theme">token economics · agent orchestration · AI security</span>
  </p>

  <!-- Featured post -->
  <div class="featured-post">
    <div class="featured-badge">FEATURED</div>
    <article class="community-post">
      {communityData.featured.url ? (
        <a href={communityData.featured.url} class="post-link">
          <h3>{communityData.featured.title}</h3>
        </a>
      ) : (
        <h3>{communityData.featured.title}</h3>
      )}
      <p class="post-meta">{communityData.featured.meta}</p>
      <p class="post-desc">{communityData.featured.description}</p>
    </article>
  </div>

  <!-- Additional posts -->
  <ul class="post-list">
    {communityData.additional.map((post) => (
      <li>
        <article class="community-post">
          {post.url ? (
            <a href={post.url} class="post-link">
              <h3>{post.title}</h3>
            </a>
          ) : (
            <h3>{post.title}</h3>
          )}
          <p class="post-meta">
            {post.meta}
          </p>
          <p class="post-desc">{post.description}</p>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .community-section {
    margin-bottom: var(--space-20);
  }

  /* Use shared .section-moral and section h2 from global.css */

  .community-intro {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-12);
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  .community-theme {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-top: var(--space-2);
    font-style: italic;
    font-family: var(--font-sans);
  }

  /* Featured post section */
  .featured-post {
    position: relative;
    margin-bottom: var(--space-16);
  }

  .featured-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
  }

  .community-post {
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    border-radius: 8px;
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .community-post {
      transition: none;
    }
  }

  .community-post:hover {
    background: var(--color-bg);
    border-color: var(--accent);
  }

  .post-link {
    text-decoration: none;
    color: inherit;
  }

  .post-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: 0.25rem;
  }

  .community-post h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  .post-meta {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    margin: 0 0 var(--space-3) 0;
  }

  .post-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  /* Post list */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-8);
  }

  .post-list li {
    display: flex;
  }

  .post-list .community-post {
    width: 100%;
  }

  /* Responsive: fix grid layout on small screens */
  @media (max-width: 640px) {
    .community-section {
      max-width: 100%;
      margin: 0 0 var(--space-20) 0;
      padding: var(--space-6) var(--space-4);
    }

    .post-list {
      grid-template-columns: 1fr;
    }
  }
</style>
