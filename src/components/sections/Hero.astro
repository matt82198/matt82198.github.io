---
// Hero section — full-viewport landing statement
// Data-count values and JS fallbacks derived from src/data/aesop-stats.json at build time
//
// MOBILE FIX (PR #25): Uses min-height: 100dvh (dynamic viewport height) with 100vh fallback.
// This prevents layout reflow when the browser's address bar toggles on scroll.
// See: tests/mobile-scroll-regression.test.mjs
import stats from '../../data/aesop-stats.json';
import measured from '../../data/measured.json';
---

<section class="hero" id="hero">
  <div class="hero-content">
    <h1 class="hero-title">MATT CULLITON</h1>

    <p class="hero-tagline">Senior Full-Stack &amp; AI Systems Engineer</p>

    <p class="hero-subhead">
      TypeScript · Java/Spring · Python · multi-agent orchestration. Measured cost and reliability in production autonomous systems. Chicago.
    </p>

    <div class="aesop-volume">
      <div class="volume-eyebrow">
        What <a href="#aesop">Aesop</a> has shipped
      </div>

      <div class="proof-tiles">
        {stats.merged_prs != null && (
          <div class="proof-tile">
            <div class="proof-value" style="font-variant-numeric: tabular-nums;">{stats.merged_prs}</div>
            <div class="proof-label">PRs merged</div>
          </div>
        )}
        {stats.commits != null && (
          <div class="proof-tile">
            <div class="proof-value" style="font-variant-numeric: tabular-nums;">{stats.commits}</div>
            <div class="proof-label">Commits</div>
          </div>
        )}
        {(stats.releases ?? null) != null && (
          <div class="proof-tile">
            <div class="proof-value" style="font-variant-numeric: tabular-nums;">{stats.releases}</div>
            <div class="proof-label">Releases</div>
          </div>
        )}
        {(stats.incidents ?? null) != null && (
          <div class="proof-tile">
            <div class="proof-value" style="font-variant-numeric: tabular-nums;">{stats.incidents}</div>
            <div class="proof-label">Incidents turned into traps</div>
          </div>
        )}
        {(stats.days_active ?? null) != null && (
          <div class="proof-tile">
            <div class="proof-value" style="font-variant-numeric: tabular-nums;">{stats.days_active}</div>
            <div class="proof-label">Days running</div>
          </div>
        )}
        {stats.test_files != null && (
          <div class="proof-tile">
            <div class="proof-value" style="font-variant-numeric: tabular-nums;">{stats.test_files}</div>
            <div class="proof-label">Test files</div>
          </div>
        )}
      </div>

      <div class="volume-footnote">
        Computed from the aesop repo at build time · updated {stats.refreshed_at ? stats.refreshed_at.split('T')[0] : 'build time'}
      </div>
    </div>

    <div class="cta-links">
      <a href="/resume.pdf" class="cta-button cta-primary">Resume</a>
      <a href="https://github.com/matt82198" class="cta-button" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="mailto:matt82198@gmail.com" class="cta-button">Email</a>
      <a href="https://linkedin.com/in/matt-culliton-a8327676" class="cta-button" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>

  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: var(--space-8);
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .hero-content {
    max-width: 600px;
    text-align: center;
  }

  .hero-title {
    font-size: var(--text-4xl);
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 var(--space-3) 0;
    line-height: var(--leading-tight);
  }

  .hero-tagline {
    font-size: var(--text-lg);
    font-family: var(--font-sans);
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
    line-height: var(--leading-normal);
    font-weight: 600;
  }

  .hero-subhead {
    font-size: var(--text-base);
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-6) 0;
    line-height: var(--leading-normal);
  }

  .aesop-volume {
    margin: 0 0 var(--space-6) 0;
  }

  .volume-eyebrow {
    font-size: var(--text-sm);
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin: 0 0 var(--space-3) 0;
  }

  .volume-eyebrow a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .volume-eyebrow a:hover {
    color: var(--accent-light);
  }

  .volume-eyebrow a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .proof-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: var(--space-4);
    margin: 0 0 var(--space-3) 0;
  }

  .volume-footnote {
    font-size: var(--text-2xs);
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .proof-tile {
    padding: var(--space-4);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-align: center;
  }

  .proof-value {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--accent);
    font-family: var(--font-mono);
    margin: 0 0 var(--space-2) 0;
  }

  .proof-label {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    font-weight: 500;
    letter-spacing: var(--tracking-normal);
  }

  .cta-links {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--accent);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    font-family: var(--font-sans);
    transition: all var(--duration-fast) var(--ease-out);
    cursor: pointer;
  }

  .cta-button:hover {
    background: var(--color-bg-secondary);
    border-color: var(--accent);
  }

  .cta-button:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .cta-primary {
    background: var(--accent);
    color: var(--color-bg);
    border-color: var(--accent);
  }

  .cta-primary:hover {
    background: var(--accent-light);
    border-color: var(--accent-light);
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
      padding: var(--space-6);
    }

    .hero-title {
      font-size: var(--text-2xl);
      margin-bottom: var(--space-2);
    }

    .hero-tagline {
      font-size: var(--text-sm);
      margin-bottom: var(--space-2);
    }

    .hero-subhead {
      font-size: var(--text-xs);
      margin-bottom: var(--space-4);
      line-height: var(--leading-tight);
    }

    .aesop-volume {
      margin-bottom: var(--space-4);
    }

    .volume-eyebrow {
      font-size: var(--text-2xs);
      margin-bottom: var(--space-2);
    }

    .proof-tiles {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-2);
      margin-bottom: var(--space-2);
    }

    .proof-tile {
      padding: var(--space-2);
    }

    .proof-value {
      font-size: var(--text-lg);
      margin-bottom: var(--space-1);
    }

    .proof-label {
      font-size: var(--text-2xs);
    }

    .volume-footnote {
      font-size: var(--text-3xs);
    }

    .cta-links {
      gap: var(--space-1);
    }

    .cta-button {
      padding: var(--space-1) var(--space-3);
      font-size: var(--text-2xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-button {
      transition: none;
    }
  }
</style>
