---
// Aesop section: the orchestration harness that ships its own features
// Component contract: no props, system fonts only, tokens.css custom properties
import stats from '../../data/aesop-stats.json';
import DemoClip from '../DemoClip.astro';
---

<section class="aesop-section">
  <p class="section-moral">
    <em>The fox measured twice and paid for one architecture.</em>
  </p>

  <h2 id="aesop">Aesop — crash-only filesystem-as-memory</h2>

  <div class="aesop-pitch">
    <p>
      Production orchestration platform for autonomous software development built on crash-only filesystem-as-memory.
      <a href="https://github.com/matt82198/aesop" target="_blank" rel="noopener noreferrer" class="cta-link">github.com/matt82198/aesop</a>
    </p>
  </div>

  <div class="essay-callout">
    <div class="essay-card">
      <h3 class="essay-title">The Aesop Hypothesis</h3>
      <p class="essay-subtitle">AI agents that survive because they're designed to fail</p>
      <p class="essay-description">
        The design bet, argued: durable text state over databases, crash-only execution over long-lived agents, failure as the normal path.
      </p>
      <a href="https://medium.com/@matt82198/the-aesop-hypothesis-ai-agents-that-survive-because-theyre-designed-to-fail-de5f033369d4" target="_blank" rel="noopener noreferrer" class="essay-link">Read on Medium →</a>
    </div>
  </div>

  <DemoClip
    src="/media/clips/parallel-fleet.mp4"
    poster="/media/clips/parallel-fleet.gif"
    alt="Multiple agents running in parallel across different domains — security linting, doc generation, and concurrent fixes. Several PRs being created simultaneously by independent agents."
    caption="Multiple agents dispatched simultaneously across domains, creating PRs in parallel."
  />

  <div class="findings-section">
    <h3>What it proved</h3>
    <ul class="findings-list">
      <li>
        <strong>Zombie gates</strong> — 79% of "open" tracker items had already shipped; a fail-closed gate now auto-closes an item when its PR is <a href="https://github.com/matt82198/aesop/blob/main/docs/RECEIPTS.md" target="_blank" rel="noopener noreferrer" class="inline-link">MERGED</a>.
      </li>
      <li>
        <strong>Green can mean never ran</strong> — CI that reports pass without executing tests, <a href="https://github.com/matt82198/aesop/blob/main/docs/GATES-FIRED.md" target="_blank" rel="noopener noreferrer" class="inline-link">caught and trapped</a>; every fix ships with a regression trap from the incident log.
      </li>
      <li>
        <strong>Flat beats hierarchical</strong> — <a href="https://github.com/matt82198/aesop/blob/main/docs/ab-cost-dataset.md" target="_blank" rel="noopener noreferrer" class="inline-link">hierarchical specialist dispatch measured at 4.3× the cost</a> of flat Haiku lanes for identical output.
      </li>
      <li>
        <strong>Haiku holds the seam</strong> — 39/39 on the held-out seam-level <a href="https://github.com/matt82198/aesop/tree/main/bench/results" target="_blank" rel="noopener noreferrer" class="inline-link">benchmark</a>; expensive models are the orchestrator, not the workers.
      </li>
      <li>
        <strong>MERGED is the only receipt</strong> — a merge tool exiting 0 proves nothing; the <a href="https://github.com/matt82198/aesop/blob/main/docs/HOW-THE-LOOP-WORKS.md" target="_blank" rel="noopener noreferrer" class="inline-link">gate queries the platform for merged state</a>.
      </li>
      <li>
        <strong>The Receipts Loop</strong> — a crash-only outer loop where an iteration counts only when it leaves <a href="https://github.com/matt82198/aesop/blob/main/docs/paper/aesop-arxiv.tex" target="_blank" rel="noopener noreferrer" class="inline-link">checkable artifacts on disk</a>; written up with dated commits.
      </li>
    </ul>
  </div>

</section>

<style>
  .aesop-section {
    margin: var(--space-16) 0;
  }

  /* Use shared .section-moral from global.css */

  /* Adjust h2 scroll margin */
  .aesop-section h2 {
    scroll-margin-top: 80px;
  }

  .aesop-section h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-top: var(--space-12);
    margin-bottom: var(--space-6);
    line-height: var(--leading-tight);
    font-family: var(--font-sans);
  }

  .aesop-pitch {
    max-width: var(--width-prose);
    margin-bottom: var(--space-12);
  }

  .aesop-pitch p {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .aesop-pitch strong {
    color: var(--accent);
    font-weight: 600;
  }

  .cta-link,
  .inline-link {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out);
  }

  .cta-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    margin: calc(var(--space-1) * -1) calc(var(--space-2) * -1);
    border-radius: 2px;
  }

  .inline-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .cta-link:hover {
    color: var(--accent-light);
    border-bottom-color: var(--accent-light);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .cta-link:focus {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-link {
      transition: none;
    }
  }

  .findings-section {
    margin-bottom: var(--space-12);
  }

  .findings-section h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-top: var(--space-12);
    margin-bottom: var(--space-6);
    line-height: var(--leading-tight);
    font-family: var(--font-sans);
  }

  .findings-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .findings-list li {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
  }

  .findings-list strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .findings-list .inline-link {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .findings-list .inline-link:hover {
    color: var(--accent-light);
    border-bottom-color: var(--accent-light);
  }

  .essay-callout {
    margin: var(--space-12) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-8);
  }

  .essay-card {
    padding: var(--space-8);
    background-color: var(--color-bg-secondary);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
  }

  .essay-title {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 var(--space-2) 0;
    font-family: var(--font-sans);
  }

  .essay-subtitle {
    font-size: var(--text-base);
    color: var(--color-text);
    font-weight: 500;
    margin: 0 0 var(--space-4) 0;
    font-style: italic;
  }

  .essay-description {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4) 0;
  }

  .essay-link {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-size: var(--text-base);
    font-weight: 500;
    border-bottom: 1px solid var(--accent);
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
    padding: var(--space-1) 0;
  }

  .essay-link:hover {
    color: var(--accent-light);
    border-bottom-color: var(--accent-light);
  }

  .essay-link:focus {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  @media (prefers-reduced-motion: reduce) {
    .essay-link {
      transition: none;
    }
  }


</style>
