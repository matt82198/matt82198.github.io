---
// Writing section: Medium essays + interactive artifacts, data-driven with interactive filtering
// Merges Medium RSS feed (fetched at build time) + artifacts with manual overrides
import mediumFeed from '../../data/medium-feed.json';
import writingOverrides from '../../data/writing-overrides.json';
import artifacts from '../../data/artifacts.json';
import fallbackData from '../../data/writing.json';

// Helper to format dates from ISO to readable format
function formatDate(isoDate: string): string {
  const date = new Date(isoDate);
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
  return date.toLocaleDateString('en-US', options);
}

// Build unified items array from feed + artifacts + overrides
function buildItems(feed: any, overrides: any, artifactData: any, fallback: any): any[] {
  let items: any[] = [];

  // Start with feed posts if available
  if (feed && feed.posts && feed.posts.length > 0) {
    items = feed.posts.map((post: any) => {
      const override = overrides.overrides[post.url] || {};
      return {
        kind: 'essay',
        title: post.title,
        url: post.url,
        date: post.date,
        image: post.image,
        tags: post.tags,
        excerpt: post.excerpt,
        description: override.description || post.excerpt,
        views: override.views || null,
        featured: override.featured || false
      };
    });
  }

  // Add artifacts (newest first, no views)
  if (artifactData && artifactData.artifacts) {
    const artifactItems = artifactData.artifacts.map((artifact: any) => ({
      kind: 'interactive',
      title: artifact.title,
      url: artifact.url,
      date: artifact.date,
      image: null,
      tags: [],
      excerpt: artifact.description,
      description: artifact.description,
      views: null,
      featured: false
    }));
    items = [...artifactItems, ...items];
  }

  // Fallback to hardcoded data if feed is empty
  if (items.length === 0 && fallback) {
    const allFallback = [...(fallback.featured || []), ...(fallback.additional || [])];
    items = allFallback.map((item: any) => {
      const override = overrides.overrides[item.url] || {};
      return {
        kind: 'essay',
        title: item.title,
        url: item.url,
        date: item.date,
        image: null,
        tags: [],
        excerpt: item.description,
        description: override.description || item.description,
        views: override.views || null,
        featured: override.featured || false
      };
    });
  }

  return items;
}

const items = buildItems(mediumFeed, writingOverrides, artifacts, fallbackData);

// Sort by most recent for initial render
const itemsByRecent = [...items].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Featured items (top 2 of current sort)
const featuredItems = itemsByRecent.slice(0, 2);
const additionalItems = itemsByRecent.slice(2);

// For Most Viewed sort, prepare items with views (those without views go to the end)
const itemsByViews = [...items].sort((a, b) => {
  // Both have views: sort by views descending
  if (a.views !== null && b.views !== null) {
    return b.views - a.views;
  }
  // Only a has views: a comes first
  if (a.views !== null) return -1;
  // Only b has views: b comes first
  if (b.views !== null) return 1;
  // Neither has views: sort by date descending
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});

const featuredItemsByViews = itemsByViews.slice(0, 2);
const additionalItemsByViews = itemsByViews.slice(2);
---

<section class="writing-section">
  <p class="section-moral">
    <em>The crow wrote down what the pitcher taught it.</em>
  </p>

  <h2 id="writing">Writing</h2>

  <!-- Filter controls -->
  <div class="filter-controls">
    <button
      class="filter-btn filter-btn-recent"
      aria-pressed="true"
      data-sort="recent"
    >
      Most Recent
    </button>
    <button
      class="filter-btn filter-btn-views"
      aria-pressed="false"
      data-sort="views"
    >
      Most Viewed
    </button>
  </div>

  <!-- Featured items: first two with visual prominence -->
  <div class="featured-essays" data-sort="recent" data-featured="true">
    {featuredItems.map((item) => (
      <article class="featured-essay">
        <div class="essay-header">
          <a href={item.url} class="essay-link" target={item.kind === 'interactive' ? '_blank' : undefined} rel={item.kind === 'interactive' ? 'noopener' : undefined}>
            <h3>{item.title}</h3>
          </a>
          {item.kind === 'interactive' && <span class="badge badge-interactive">Interactive</span>}
          {item.kind === 'essay' && <span class="badge badge-essay">Essay</span>}
        </div>
        <time datetime={item.date} class="essay-date">{formatDate(item.date)}</time>
        <p class="essay-desc">{item.description}</p>
      </article>
    ))}
  </div>

  <!-- Featured items by views (hidden by default) -->
  <div class="featured-essays" data-sort="views" data-featured="true" style="display: none;">
    {featuredItemsByViews.map((item) => (
      <article class="featured-essay">
        <div class="essay-header">
          <a href={item.url} class="essay-link" target={item.kind === 'interactive' ? '_blank' : undefined} rel={item.kind === 'interactive' ? 'noopener' : undefined}>
            <h3>{item.title}</h3>
          </a>
          {item.kind === 'interactive' && <span class="badge badge-interactive">Interactive</span>}
          {item.kind === 'essay' && <span class="badge badge-essay">Essay</span>}
        </div>
        <time datetime={item.date} class="essay-date">{formatDate(item.date)}</time>
        <p class="essay-desc">{item.description}</p>
      </article>
    ))}
  </div>

  <!-- Additional items: compact list (most recent) -->
  <ul class="essay-list" data-sort="recent" data-featured="false">
    {additionalItems.map((item) => (
      <li>
        <span class="essay-title">
          <a href={item.url} class="list-link" target={item.kind === 'interactive' ? '_blank' : undefined} rel={item.kind === 'interactive' ? 'noopener' : undefined}>
            {item.title}
          </a>
          {item.kind === 'interactive' && <span class="badge badge-interactive badge-inline">Interactive</span>}
          {item.kind === 'essay' && <span class="badge badge-essay badge-inline">Essay</span>}
        </span>
        <span class="essay-meta">
          <time datetime={item.date}>{formatDate(item.date)}</time>
          — {item.description}
        </span>
      </li>
    ))}
  </ul>

  <!-- Additional items: compact list (most viewed, hidden by default) -->
  <ul class="essay-list" data-sort="views" data-featured="false" style="display: none;">
    {additionalItemsByViews.map((item) => (
      <li>
        <span class="essay-title">
          <a href={item.url} class="list-link" target={item.kind === 'interactive' ? '_blank' : undefined} rel={item.kind === 'interactive' ? 'noopener' : undefined}>
            {item.title}
          </a>
          {item.kind === 'interactive' && <span class="badge badge-interactive badge-inline">Interactive</span>}
          {item.kind === 'essay' && <span class="badge badge-essay badge-inline">Essay</span>}
        </span>
        <span class="essay-meta">
          <time datetime={item.date}>{formatDate(item.date)}</time>
          — {item.description}
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .writing-section {
    margin-bottom: var(--space-20);
  }

  /* Use shared .section-moral and section h2 from global.css */

  /* Filter controls */
  .filter-controls {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out),
                color var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-btn {
      transition: none;
    }
  }

  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-btn:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .filter-btn[aria-pressed="true"] {
    background: var(--color-bg-secondary);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Badges */
  .badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    margin-left: var(--space-2);
  }

  .badge-essay {
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .badge-interactive {
    background: var(--color-bg-secondary);
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .badge-inline {
    font-size: var(--text-xs);
    padding: 0.125rem 0.375rem;
    margin-left: var(--space-1);
  }

  /* Featured essays grid */
  .featured-essays {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-16);
  }

  .featured-essay {
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    border-radius: 8px;
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-essay {
      transition: none;
    }
  }

  .featured-essay:hover {
    background: var(--color-bg);
    border-color: var(--accent);
  }

  .essay-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .essay-link {
    text-decoration: none;
    color: inherit;
    flex: 1;
  }

  .essay-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: 0.25rem;
  }

  .featured-essay h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--space-4) 0;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  .essay-date {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    display: block;
    margin-bottom: var(--space-3);
  }

  .essay-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  /* Essay list */
  .essay-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .essay-list li {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .essay-list li:last-child {
    border-bottom: none;
  }

  .essay-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .list-link {
    font-size: var(--text-base);
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .list-link {
      transition: none;
    }
  }

  .list-link:hover {
    color: var(--accent-light);
  }

  .list-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: 0.125rem;
  }

  .essay-meta {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  .essay-meta time {
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
  }
</style>

<script>
  // Client-side filter toggle (vanilla, works with/without prefers-reduced-motion)
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const featuredSections = document.querySelectorAll('[data-featured="true"]');
    const listSections = document.querySelectorAll('[data-featured="false"]');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sortMode = btn.dataset.sort; // 'recent' or 'views'

        // Update button states
        filterBtns.forEach((b) => {
          b.setAttribute('aria-pressed', b.dataset.sort === sortMode ? 'true' : 'false');
        });

        // Toggle visibility: show matching sort mode, hide others
        featuredSections.forEach((section) => {
          if (section.dataset.sort === sortMode) {
            section.style.display = '';
          } else {
            section.style.display = 'none';
          }
        });

        listSections.forEach((section) => {
          if (section.dataset.sort === sortMode) {
            section.style.display = '';
          } else {
            section.style.display = 'none';
          }
        });
      });
    });
  });
</script>
