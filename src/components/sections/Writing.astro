---
// Writing section: essays, field notes, and interactive artifacts
// Imports: Medium essays + interactive artifacts with subsection organization
import mediumFeed from '../../data/medium-feed.json';
import writingOverrides from '../../data/writing-overrides.json';
import artifacts from '../../data/artifacts.json';
import authorship from '../../data/authorship.json';
import fallbackData from '../../data/writing.json';

// Helper to format dates from ISO to readable format
function formatDate(isoDate: string): string {
  const date = new Date(isoDate);
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric' };
  return date.toLocaleDateString('en-US', options);
}

// Helper to get author info from authorship map
function getAuthorInfo(url: string) {
  const auth = authorship.essays[url] || { author: 'matt', series: null };
  return auth;
}

// Helper to get author display name
function getAuthorDisplayName(author: string): string {
  return author === 'orchestrator' ? 'Aesop orchestrator' : 'Matt Culliton';
}

// Build unified items array from feed + artifacts + overrides
function buildEssays(feed: any, overrides: any, authorship: any, fallback: any): any[] {
  let items: any[] = [];

  // Start with feed posts if available
  if (feed && feed.posts && feed.posts.length > 0) {
    items = feed.posts.map((post: any) => {
      const override = overrides.overrides[post.url] || {};
      const auth = getAuthorInfo(post.url);
      return {
        kind: 'essay',
        title: post.title,
        url: post.url,
        date: post.date,
        image: post.image,
        tags: post.tags,
        excerpt: post.excerpt,
        description: override.description || post.excerpt,
        views: override.views || null,
        featured: override.featured || false,
        author: auth.author,
        series: auth.series
      };
    });
  }

  // Fallback to hardcoded data if feed is empty
  if (items.length === 0 && fallback) {
    const allFallback = [...(fallback.featured || []), ...(fallback.additional || [])];
    items = allFallback.map((item: any) => {
      const override = overrides.overrides[item.url] || {};
      const auth = getAuthorInfo(item.url);
      return {
        kind: 'essay',
        title: item.title,
        url: item.url,
        date: item.date,
        image: null,
        tags: [],
        excerpt: item.description,
        description: override.description || item.description,
        views: override.views || null,
        featured: override.featured || false,
        author: auth.author,
        series: auth.series
      };
    });
  }

  return items;
}

// Build artifact items
function buildArtifacts(artifactData: any): any[] {
  if (!artifactData || !artifactData.artifacts) return [];
  return artifactData.artifacts.map((artifact: any) => ({
    kind: 'interactive',
    title: artifact.title,
    url: artifact.url,
    date: artifact.date,
    image: null,
    tags: [],
    excerpt: artifact.description,
    description: artifact.description,
    views: null,
    featured: artifact.featured || false,
    group: artifact.group,
    author: artifact.author
  }));
}

// Separate essays by author
function separateEssays(essays: any[]): { matt: any[], orchestrator: any[] } {
  const matt = essays.filter(e => e.author === 'matt');
  const orchestrator = essays.filter(e => e.author === 'orchestrator');
  return { matt, orchestrator };
}

// Separate artifacts by group
function separateArtifactsByGroup(artifacts: any[]): Map<string, any[]> {
  const groups = new Map<string, any[]>();
  artifacts.forEach(artifact => {
    const groupName = artifact.group;
    if (!groups.has(groupName)) {
      groups.set(groupName, []);
    }
    groups.get(groupName)!.push(artifact);
  });
  return groups;
}

const essays = buildEssays(mediumFeed, writingOverrides, authorship, fallbackData);
const artifactItems = buildArtifacts(artifacts);
const { matt: mattEssays, orchestrator: orchestratorEssays } = separateEssays(essays);
const artifactGroups = separateArtifactsByGroup(artifactItems);

// Sort essays by date (most recent first)
mattEssays.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
orchestratorEssays.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Create subsections with sorted data
type Subsection = {
  title: string;
  description?: string;
  items: any[];
};

const subsections: Subsection[] = [
  {
    title: 'Essays',
    items: mattEssays
  },
  {
    title: 'Field notes from an AI orchestrator',
    description: 'A series written by Claude, the orchestrator process of the Aesop fleet, and published by Matt.',
    items: orchestratorEssays
  }
];

// Add artifact groups as subsections
Array.from(artifactGroups.entries()).forEach(([groupName, items]) => {
  subsections.push({
    title: groupName,
    description: groupName === 'Aesop — architecture, field notes and results' || groupName === 'World of Warcraft addon engineering (CMC / SimpleUI)' || groupName === 'Sports analytics'
      ? (groupName === 'Sports analytics' ? 'Built in Claude Code and published as artifacts; written by the Aesop orchestrator unless marked, Matt directs, reviews and signs off.' : 'Built in Claude Code and published as artifacts; written by the Aesop orchestrator unless marked, Matt directs, reviews and signs off.')
      : 'Built in Claude Code and published as artifacts; written by the Aesop orchestrator unless marked, Matt directs, reviews and signs off.',
    items: items.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  });
});
---

<section class="writing-section">
  <p class="section-moral">
    <em>The crow wrote down what the pitcher taught it.</em>
  </p>

  <h2 id="writing">Writing</h2>

  <!-- Filter controls -->
  <div class="filter-controls">
    <button
      class="filter-btn filter-btn-recent"
      aria-pressed="true"
      data-sort="recent"
    >
      Most Recent
    </button>
    <button
      class="filter-btn filter-btn-views"
      aria-pressed="false"
      data-sort="views"
    >
      Most Viewed
    </button>
  </div>

  <!-- Subsections -->
  {subsections.map((subsection) => {
    // Sort items for this subsection
    const itemsByRecent = [...subsection.items].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    const itemsByViews = [...subsection.items].sort((a, b) => {
      if (a.views !== null && b.views !== null) {
        return b.views - a.views;
      }
      if (a.views !== null) return -1;
      if (b.views !== null) return 1;
      if (a.featured !== b.featured) {
        return a.featured ? -1 : 1;
      }
      return new Date(b.date).getTime() - new Date(a.date).getTime();
    });

    const featuredRecent = itemsByRecent.slice(0, 2);
    const additionalRecent = itemsByRecent.slice(2);
    const featuredViews = itemsByViews.slice(0, 2);
    const additionalViews = itemsByViews.slice(2);

    return (
      <div class="writing-subsection">
        <h3 class="subsection-title">{subsection.title}</h3>
        {subsection.description && (
          <p class="subsection-description">{subsection.description}</p>
        )}

        <!-- Featured items: recent -->
        <div class="featured-essays" data-sort="recent" data-featured="true" data-subsection={subsection.title}>
          {featuredRecent.map((item) => (
            <article class="featured-essay">
              <div class="essay-header">
                <a href={item.url} class="essay-link" target={item.kind === 'interactive' ? '_blank' : undefined} rel={item.kind === 'interactive' ? 'noopener' : undefined}>
                  <h4>{item.title}</h4>
                </a>
                {item.kind === 'interactive' && <span class="badge badge-interactive">Interactive</span>}
                {item.kind === 'essay' && <span class="badge badge-essay">Essay</span>}
              </div>
              <div class="essay-meta-row">
                <time datetime={item.date} class="essay-date">{formatDate(item.date)}</time>
                <span class="author-chip">{getAuthorDisplayName(item.author)}</span>
              </div>
              <p class="essay-desc">{item.description}</p>
            </article>
          ))}
        </div>

        <!-- Featured items: views -->
        <div class="featured-essays" data-sort="views" data-featured="true" data-subsection={subsection.title} style="display: none;">
          {featuredViews.map((item) => (
            <article class="featured-essay">
              <div class="essay-header">
                <a href={item.url} class="essay-link" target={item.kind === 'interactive' ? '_blank' : undefined} rel={item.kind === 'interactive' ? 'noopener' : undefined}>
                  <h4>{item.title}</h4>
                </a>
                {item.kind === 'interactive' && <span class="badge badge-interactive">Interactive</span>}
                {item.kind === 'essay' && <span class="badge badge-essay">Essay</span>}
              </div>
              <div class="essay-meta-row">
                <time datetime={item.date} class="essay-date">{formatDate(item.date)}</time>
                <span class="author-chip">{getAuthorDisplayName(item.author)}</span>
              </div>
              <p class="essay-desc">{item.description}</p>
            </article>
          ))}
        </div>

        <!-- Additional items: recent -->
        {additionalRecent.length > 0 && (
          <ul class="essay-list" data-sort="recent" data-featured="false" data-subsection={subsection.title}>
            {additionalRecent.map((item) => (
              <li>
                <span class="essay-title">
                  <a href={item.url} class="list-link" target={item.kind === 'interactive' ? '_blank' : undefined} rel={item.kind === 'interactive' ? 'noopener' : undefined}>
                    {item.title}
                  </a>
                  {item.kind === 'interactive' && <span class="badge badge-interactive badge-inline">Interactive</span>}
                  {item.kind === 'essay' && <span class="badge badge-essay badge-inline">Essay</span>}
                </span>
                <span class="essay-meta">
                  <time datetime={item.date}>{formatDate(item.date)}</time>
                  <span class="author-chip-inline">{getAuthorDisplayName(item.author)}</span>
                  — {item.description}
                </span>
              </li>
            ))}
          </ul>
        )}

        <!-- Additional items: views -->
        {additionalViews.length > 0 && (
          <ul class="essay-list" data-sort="views" data-featured="false" data-subsection={subsection.title} style="display: none;">
            {additionalViews.map((item) => (
              <li>
                <span class="essay-title">
                  <a href={item.url} class="list-link" target={item.kind === 'interactive' ? '_blank' : undefined} rel={item.kind === 'interactive' ? 'noopener' : undefined}>
                    {item.title}
                  </a>
                  {item.kind === 'interactive' && <span class="badge badge-interactive badge-inline">Interactive</span>}
                  {item.kind === 'essay' && <span class="badge badge-essay badge-inline">Essay</span>}
                </span>
                <span class="essay-meta">
                  <time datetime={item.date}>{formatDate(item.date)}</time>
                  <span class="author-chip-inline">{getAuthorDisplayName(item.author)}</span>
                  — {item.description}
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>
    );
  })}
</section>

<style>
  .writing-section {
    margin-bottom: var(--space-20);
  }

  /* Subsection heading and description */
  .writing-subsection {
    margin-bottom: var(--space-16);
  }

  .subsection-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: var(--space-8) 0 var(--space-2) 0;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  .subsection-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-6) 0;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
    font-style: italic;
  }

  /* Filter controls */
  .filter-controls {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out),
                color var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .filter-btn {
      transition: none;
    }
  }

  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-btn:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .filter-btn[aria-pressed="true"] {
    background: var(--color-bg-secondary);
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Badges */
  .badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    margin-left: var(--space-2);
  }

  .badge-essay {
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .badge-interactive {
    background: var(--color-bg-secondary);
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .badge-inline {
    font-size: var(--text-xs);
    padding: 0.125rem 0.375rem;
    margin-left: var(--space-1);
  }

  /* Author chip */
  .author-chip {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 2px;
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    margin-left: var(--space-2);
  }

  .author-chip-inline {
    display: inline;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    margin: 0 var(--space-1);
  }

  /* Featured essays grid */
  .featured-essays {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .featured-essay {
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    border-radius: 8px;
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-essay {
      transition: none;
    }
  }

  .featured-essay:hover {
    background: var(--color-bg);
    border-color: var(--accent);
  }

  .essay-header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .essay-link {
    text-decoration: none;
    color: inherit;
    flex: 1;
  }

  .essay-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: 0.25rem;
  }

  .featured-essay h4 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  .essay-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-3) 0;
    flex-wrap: wrap;
  }

  .essay-date {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    margin: 0;
  }

  .essay-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin: 0;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  /* Essay list */
  .essay-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-12) 0;
  }

  .essay-list li {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .essay-list li:last-child {
    border-bottom: none;
  }

  .essay-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .list-link {
    font-size: var(--text-base);
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
    transition: color var(--duration-fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .list-link {
      transition: none;
    }
  }

  .list-link:hover {
    color: var(--accent-light);
  }

  .list-link:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    border-radius: 0.125rem;
  }

  .essay-meta {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    line-height: var(--leading-normal);
  }

  .essay-meta time {
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
  }
</style>

<script>
  // Client-side filter toggle (vanilla, works with/without prefers-reduced-motion)
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const featuredSections = document.querySelectorAll('[data-featured="true"]');
    const listSections = document.querySelectorAll('[data-featured="false"]');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sortMode = btn.dataset.sort; // 'recent' or 'views'

        // Update button states
        filterBtns.forEach((b) => {
          b.setAttribute('aria-pressed', b.dataset.sort === sortMode ? 'true' : 'false');
        });

        // Toggle visibility: show matching sort mode, hide others (all subsections)
        featuredSections.forEach((section) => {
          if (section.dataset.sort === sortMode) {
            section.style.display = '';
          } else {
            section.style.display = 'none';
          }
        });

        listSections.forEach((section) => {
          if (section.dataset.sort === sortMode) {
            section.style.display = '';
          } else {
            section.style.display = 'none';
          }
        });
      });
    });
  });
</script>
